<script setup>
    import { useAuthStore } from '~~/store/auth'
    import { useWishlistStore } from '~~/store/wishlist'
    import { useCartStore } from '~~/store/cart'

    const authStore = useAuthStore()
    const wishlistStore = useWishlistStore()
    const cartStore = useCartStore()

    const search = ref("")
    const isMobileMenuOpen = ref(false)
    const isSearchOpen = ref(false)
    const searchQuery = ref('')

    const items = ref([
        { label: "Home", to: "/" },
        { label: "Products", to: "/products" },
        { label: "Contact", to: "/contact" },
        { label: "Account", to: "/account" },
    ])

    const desktopNavItems = computed(() =>
        items.value.filter(item => item.to !== '/account')
    )

    const accountMenuItems = computed(() => [
        [
            { label: 'Orders', icon: 'i-lucide-package', to: '/account/orders' },
            { label: 'Wishlist', icon: 'i-lucide-heart', to: '/wishlist' }
        ],
        [
            { label: 'Profile', icon: 'i-lucide-user-pen', to: '/account', exact: true },
            { label: 'Logout', icon: 'i-lucide-log-out', onSelect: () => authStore.logout() }
        ]
    ])

    const cartCount = computed(() => cartStore.items?.length || 0)
    const wishlistCount = computed(() => wishlistStore.items?.length || 0)

    function submitSearch() {
        if (!searchQuery.value.trim()) return
        navigateTo({ path: '/products', query: { search: searchQuery.value } })
        isSearchOpen.value = false
    }
</script>

<template>
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-4">

                <!-- Mobile menu trigger -->
                <UButton icon="i-lucide-menu" variant="ghost" color="neutral" class="lg:hidden"
                    @click="isMobileMenuOpen = true" />

                <!-- Logo -->
                <NuxtLink to="/" class="text-xl font-bold tracking-tight shrink-0">
                    MyStore
                </NuxtLink>

                <!-- Desktop nav -->
                <UNavigationMenu :items="desktopNavItems" class="hidden lg:flex"
                    :ui="{ link: 'font-medium text-gray-700 data-[active]:text-red-500' }" />

                <!-- Desktop search -->
                <UInput v-model="searchQuery" icon="i-lucide-search" placeholder="Search for products, brands..."
                    class="hidden md:block flex-1 max-w-md" size="lg" @keyup.enter="submitSearch" />

                <!-- Right actions -->
                <div class="flex items-center gap-1 sm:gap-2 shrink-0">
                    <UButton icon="i-lucide-search" variant="ghost" color="neutral" class="md:hidden"
                        @click="isSearchOpen = true" />

                    <UButton icon="i-lucide-heart" variant="ghost" color="neutral" to="/wishlist"
                        class="hidden sm:flex relative">
                        <UBadge v-if="wishlistCount" :label="wishlistCount" color="red" size="xs"
